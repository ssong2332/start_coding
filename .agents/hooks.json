{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file|write_file|edit_file|view_file|replace_file_content|multi_replace_file_content|write_to_file|grep_search|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agy-guard.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "syntax-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/check-syntax.js",
        "timeout": 10
      }
    ]
  }
}
